# Copia este fichero como .env en la raíz del repo y rellena lo que vayas a usar.
# Cada script busca el .env subiendo desde la carpeta en la que lo ejecutas.

# instrumentos/ (opcional: sin estas claves funciona igual, solo sin foto ni géneros)
SPOTIFY_ID=
SPOTIFY_SECRET=

# twitch/
TWITCH_ID=
TWITCH_SECRET=

# asistente-voz/  (basta con la del cerebro que vayas a usar)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Opcional: cambiar de modelo sin tocar el código
# CLAUDE_MODEL=claude-haiku-5-5
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
# AST_MODEL=MIT/ast-finetuned-audioset-10-10-0.4593
